TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: allowed Telegram sender when TELEGRAM_CHAT_ID is a group. Defaults to the chat ID.
TELEGRAM_USER_ID=
HELIUS_API_KEY=
# Optional: automatic HTTP/WSS failover when the active key exhausts its credits.
HELIUS_API_KEY_BACKUP=
AGENT_WALLET_PUBKEY=
JUPITER_API_KEY=
# Live execution only. Keep the keypair outside this repository and chmod 600.
AGENT_KEYPAIR_PATH=
# Optional; defaults to ./data/yolow.db
DB_PATH=
# Optional; defaults to ./config.json
CONFIG_PATH=
