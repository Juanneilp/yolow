{
  "config_version": 1,
  "timezone": "Asia/Jakarta",
  "mode": {
    "dry_run": true,
    "position_poll_interval_sec": 300
  },
  "rpc": {
    "http_base": "https://mainnet.helius-rpc.com",
    "ws_base": "wss://mainnet.helius-rpc.com",
    "oor_fallback_poll_interval_sec": 15
  },
  "candles": {
    "primary": "gmgn",
    "fallback_chain": [
      "meteora",
      "geckoterminal",
      "onchain_ticks"
    ],
    "price_unit": "usd",
    "grace_window_sec": 60,
    "backfill_candles": 200,
    "stale_data_pause_sec": 300,
    "providers": {
      "gmgn": {
        "rate_limit_rps": 2
      },
      "meteora": {
        "base_url": "https://dlmm.datapi.meteora.ag",
        "rate_limit_rps": 10,
        "build_15m_from_5m": true
      },
      "geckoterminal": {
        "base_url": "https://api.geckoterminal.com/api/v2"
      },
      "onchain_ticks": {
        "enabled": true,
        "sol_usd_source": "jupiter"
      }
    }
  },
  "execution": {
    "priority_fee": {
      "mode": "fixed",
      "microlamports": 100000,
      "max_cap_microlamports": 500000
    },
    "max_retries": 3
  },
  "swap": {
    "enabled": true,
    "output": "SOL",
    "min_value_usd": 0.2,
    "slippage_bps": 500,
    "max_slippage_bps": 1500,
    "max_retries": 3,
    "close_empty_token_account": false
  },
  "top_careless": {
    "enabled": true,
    "limit": 10,
    "min_market_cap_usd": 1500000,
    "min_token_age_days": 3,
    "min_tvl_usd": 5000
  },
  "jupiter": {
    "base_url": "https://api.jup.ag/swap/v2",
    "tokens_base_url": "https://api.jup.ag/tokens/v2",
    "price_base_url": "https://api.jup.ag/price/v3"
  },
  "notify": {
    "profit_alert": {
      "enabled": true,
      "interval_minutes": 5,
      "threshold_percent": 5
    },
    "low_sol_balance_alert_sol": 0.05,
    "heartbeat": {
      "enabled": false,
      "at_time": "08:00"
    }
  },
  "history": {
    "enabled": true,
    "record_dry_run_trades": true,
    "snapshot_interval_sec": 300,
    "snapshot_retention_days": 180,
    "candle_audit_retention_days": 60,
    "post_exit_marks_min": [
      15,
      60,
      240,
      1440
    ],
    "csv_export": {
      "enabled": true,
      "dir": "./exports",
      "file": "trades.csv"
    },
    "backup": {
      "enabled": true,
      "dir": "./backups",
      "at_time": "03:00",
      "keep": 14
    }
  },
  "logging": {
    "level": "info"
  },
  "automation": {
    "enabled": false,
    "max_positions": 15,
    "position_sol": 0.5,
    "min_bin_step": 80,
    "min_price_percent": -80,
    "profit_percent": 5,
    "oor_above_percent": 10,
    "oor_below_percent": 30
  }
}
